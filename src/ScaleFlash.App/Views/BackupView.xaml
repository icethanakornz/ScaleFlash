<UserControl x:Class="ScaleFlash.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ScaleFlash.App.ViewModels"
             xmlns:views="clr-namespace:ScaleFlash.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:BackupViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="สำรองการ์ดเป็นไฟล์ image" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource SecondaryText}" FontSize="13.5" Margin="0,0,0,16"
                       Text="อ่านข้อมูลทั้งหมดจากการ์ดเครื่องชั่งที่ใช้งานได้ดี เก็บเป็นไฟล์ไว้ใช้เขียนการ์ดใบอื่น (แบบปุ่ม &gt;&gt; ของโปรแกรมเดิม)" />

            <ui:Card Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="การ์ดต้นทาง" Style="{StaticResource SectionTitle}" />
                    <TextBlock Visibility="{Binding HasDisks, Converter={StaticResource InverseBoolToVisibility}}"
                               Style="{StaticResource SecondaryText}" FontSize="13.5"
                               Text="ไม่พบการ์ด — เสียบการ์ดที่ต้องการสำรองเข้าเครื่องอ่าน" />
                    <ListBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DiskItemViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="2,4">
                                    <ui:SymbolIcon Symbol="Storage24" FontSize="24" Margin="0,0,12,0"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource SecondaryText}" />
                                        <TextBlock Text="{Binding LayoutText}" Style="{StaticResource SecondaryText}"
                                                   Visibility="{Binding LayoutText, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="บันทึกเป็นไฟล์" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <ui:Button DockPanel.Dock="Right" Content="เลือก…" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0"
                                   Command="{Binding BrowseCommand}" />
                        <ui:TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ตำแหน่งไฟล์ที่จะบันทึก" />
                    </DockPanel>
                    <StackPanel Margin="0,14,0,0">
                        <RadioButton Content="อ่านถึงพาร์ทิชันสุดท้าย (แนะนำ — ไฟล์เล็กกว่า เหมือนโปรแกรมเดิม)" IsChecked="{Binding WholeDisk, Converter={StaticResource InverseBoolConverter}}" Margin="0,2" />
                        <RadioButton Content="อ่านทั้งการ์ด" IsChecked="{Binding WholeDisk}" Margin="0,2" />
                    </StackPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ตรวจสอบไฟล์หลังสำรอง" FontSize="14" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="อ่านการ์ดซ้ำอีกรอบเพื่อเทียบกับไฟล์" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Verify}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding EstimatedSizeText}" Margin="0,12,0,0" FontSize="13.5"
                               Visibility="{Binding EstimatedSizeText, Converter={StaticResource NullToCollapsed}}" />
                </StackPanel>
            </ui:Card>

            <ui:Button Command="{Binding StartCommand}" Appearance="Primary" HorizontalAlignment="Stretch" Height="48"
                       FontSize="15" FontWeight="SemiBold" Icon="{ui:SymbolIcon ArrowDownload24}" Content="เริ่มสำรองการ์ด" Margin="0,0,0,14" />

            <ContentControl Content="{Binding Job}" Visibility="{Binding HasJob, Converter={StaticResource BoolToVisibility}}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <views:JobCard />
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
