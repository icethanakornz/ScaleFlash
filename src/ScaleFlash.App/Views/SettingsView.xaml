<UserControl x:Class="ScaleFlash.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ScaleFlash.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="ตั้งค่า / เกี่ยวกับ" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16" />

            <ui:Card Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="การเขียน" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ขนาดก้อนข้อมูลต่อครั้ง (MB)" FontSize="14" />
                            <TextBlock Style="{StaticResource SecondaryText}"
                                       Text="ค่าแนะนำ 4 MB (เท่ากับหน่วยลบของการ์ด SDHC) ปรับได้ถ้าทดสอบแล้วการ์ด/เครื่องอ่านของคุณเร็วกว่าที่ค่าอื่น" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="90" ItemsSource="{Binding ChunkSizes}" SelectedItem="{Binding ChunkSizeMB}" VerticalAlignment="Center" />
                    </Grid>
                    <Separator Margin="0,8" />
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="แสดงดิสก์ USB แบบติดตั้งถาวรด้วย (ขั้นสูง)" FontSize="14" />
                            <TextBlock Style="{StaticResource SecondaryText}"
                                       Text="ปกติจะแสดงเฉพาะเครื่องอ่านการ์ด เพื่อกันการเขียนทับ External HDD โดยไม่ตั้งใจ — เปิดเฉพาะเมื่อเครื่องอ่านการ์ดของคุณไม่แสดงในรายการ" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowFixedUsb}" VerticalAlignment="Center" />
                    </Grid>
                    <Separator Margin="0,8" />
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ซ่อนไดรฟ์ Linux จาก Windows อัตโนมัติ (กันหน้าต่างให้ Format)" FontSize="14" />
                            <TextBlock Style="{StaticResource SecondaryText}"
                                       Text="เมื่อเสียบ USB / การ์ดเครื่องชั่งขณะเปิดโปรแกรม จะเอาตัวอักษรไดรฟ์ของพาร์ทิชันที่ Windows อ่านไม่ได้ออก (เหมือน Remove drive letter ใน Disk Management) ข้อมูลไม่ถูกแก้ไข และ Windows มักจำไว้สำหรับครั้งต่อไป — ถ้าต้องการคืนตัวอักษรไดรฟ์ ใช้ Disk Management" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoHideLinuxDrives}" VerticalAlignment="Center" />
                    </Grid>
                    <Separator Margin="0,8" />
                    <DockPanel Margin="0,4">
                        <ui:Button DockPanel.Dock="Right" Content="เปิดโฟลเดอร์" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenDataFolderCommand}" />
                        <StackPanel>
                            <TextBlock Text="โฟลเดอร์ข้อมูลโปรแกรม" FontSize="14" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="เก็บการตั้งค่า ประวัติ และ log ข้อผิดพลาด" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Padding="18" Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Image Source="pack://application:,,,/Assets/app.png" Width="56" Height="56" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ScaleFlash" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Version}" Style="{StaticResource SecondaryText}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="13.5" LineHeight="22">
                        โปรแกรมเขียน image ลงการ์ด SD สำหรับเครื่องชั่ง ใช้แทน ReadDisk.exe (Yech's DiskCopy 1.3, ปี 2009)
                        <LineBreak />
                        <LineBreak />
                        <Run FontWeight="SemiBold">สิ่งที่ดีกว่าโปรแกรมเดิม</Run>
                        <LineBreak />• อ่านไฟล์ล่วงหน้าขณะเขียน การ์ดไม่ต้องรอ และไม่มีการนับถอยหลัง 5 วินาที
                        <LineBreak />• ข้ามส่วนที่เหมือนเดิมบนการ์ด (เร็วขึ้นมากเมื่อเขียนทับการ์ดเดิม)
                        <LineBreak />• เขียนหลายการ์ดพร้อมกัน และโหมดเขียนอัตโนมัติเมื่อเสียบการ์ด
                        <LineBreak />• ตรวจสอบข้อมูลหลังเขียน (โปรแกรมเดิมไม่มี)
                        <LineBreak />• ปลดล็อกการ์ดที่ Windows เปิดค้างไว้ก่อนเขียนให้อัตโนมัติ
                        <LineBreak />• แสดงความเร็ว เวลาที่เหลือ และเก็บประวัติของการ์ดทุกใบ
                        <LineBreak />• กันไม่ให้เขียนทับดิสก์ระบบและ External HDD
                        <LineBreak />• เปิดดูข้อมูล Linux ใน USB / การ์ด (เวอร์ชัน, ไฟล์, เทียบกับ image) โดยไม่ต้อง Format
                        <LineBreak />• ถ้าเขียนไม่เสร็จ (ถอดการ์ด/ไฟดับ) การ์ดจะบูตไม่ได้แทนที่จะบูตระบบที่เสียครึ่งๆ กลางๆ
                    </TextBlock>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
