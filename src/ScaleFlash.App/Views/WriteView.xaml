<UserControl x:Class="ScaleFlash.App.Views.WriteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ScaleFlash.App.ViewModels"
             xmlns:views="clr-namespace:ScaleFlash.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:WriteViewModel}"
             d:DesignWidth="980" d:DesignHeight="740">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="11*" MinWidth="460" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="9*" MinWidth="340" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT: steps ================= -->
        <DockPanel Grid.Column="0">
        <ui:Button DockPanel.Dock="Bottom" Command="{Binding StartCommand}" Appearance="Primary" HorizontalAlignment="Stretch" Height="50"
                   FontSize="16" FontWeight="SemiBold" Icon="{ui:SymbolIcon Flash24}" Margin="0,12,6,0"
                   Content="{Binding StartButtonText}" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>

                <ui:InfoBar Margin="0,0,0,12" Severity="Informational" IsClosable="False" IsOpen="{Binding AutoMode}"
                            Title="โหมดเขียนอัตโนมัติเปิดอยู่"
                            Message="เสียบการ์ดใบใหม่เข้าเครื่องอ่าน แล้วโปรแกรมจะเริ่มเขียนทันที มีเสียงแจ้งเมื่อเสร็จ" />

                <!-- Step 1: image -->
                <ui:Card Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Border Style="{StaticResource StepBadge}">
                                <TextBlock Text="1" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ComboBox x:Name="RecentBox" DockPanel.Dock="Right" Width="150" ItemsSource="{Binding RecentImages}"
                                      Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}"
                                      SelectionChanged="OnRecentSelected" ToolTip="เปิดไฟล์ที่ใช้ล่าสุด">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock DockPanel.Dock="Right" Text="ล่าสุด" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource SecondaryText}"
                                       Visibility="{Binding HasRecent, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="ไฟล์ Image" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- empty: drop zone -->
                        <Grid Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibility}}" MinHeight="120">
                            <Rectangle RadiusX="8" RadiusY="8" StrokeThickness="1.5" StrokeDashArray="5 3"
                                       Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                                <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="34" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="ลากไฟล์ image มาวางที่นี่" FontSize="15" Margin="0,8,0,8" HorizontalAlignment="Center" />
                                <ui:Button Content="เลือกไฟล์…" Icon="{ui:SymbolIcon FolderOpen24}" HorizontalAlignment="Center"
                                           Command="{Binding BrowseCommand}" Appearance="Primary" />
                                <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" Margin="0,10,0,0"
                                                 Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <!-- selected image -->
                        <Grid Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="10" Margin="0,0,14,0" VerticalAlignment="Top"
                                    Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}">
                                <ui:SymbolIcon Symbol="Scales24" FontSize="28" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding ImageTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding ImageFolder}" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <ItemsControl ItemsSource="{Binding ImageChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Chip}">
                                                <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding ImageWarnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='⚠ {0}'}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <ui:Button Grid.Column="2" Content="เปลี่ยนไฟล์" Icon="{ui:SymbolIcon FolderOpen24}" VerticalAlignment="Top"
                                       Command="{Binding BrowseCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding ImageError}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Visibility="{Binding ImageError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </ui:Card>

                <!-- Step 2: cards -->
                <ui:Card Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border Style="{StaticResource StepBadge}">
                                <TextBlock Text="2" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="ตรวจจับการ์ดอัตโนมัติ" Style="{StaticResource SecondaryText}" />
                            </StackPanel>
                            <TextBlock Text="เลือกการ์ด / USB ที่จะเขียน (เลือกได้หลายอัน)" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Visibility="{Binding HasDisks, Converter={StaticResource InverseBoolToVisibility}}"
                                   Style="{StaticResource SecondaryText}" Margin="2,6,0,6" FontSize="13.5"
                                   Text="ไม่พบการ์ดหรือ USB — เสียบเครื่องอ่านการ์ดหรือแฟลชไดรฟ์ USB แล้วรอสักครู่" />

                        <ItemsControl ItemsSource="{Binding Disks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DiskItemViewModel}">
                                    <Border CornerRadius="8" BorderThickness="1" Margin="0,0,0,8" Padding="12,10"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center"
                                                      MinWidth="0" Margin="0,0,4,0" />
                                            <ui:SymbolIcon Grid.Column="1" FontSize="26" Margin="4,0,12,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Storage24" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUsbStick}" Value="True">
                                                                <Setter Property="Symbol" Value="UsbStick24" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding CanSelect}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Details}" Style="{StaticResource SecondaryText}" />
                                                <TextBlock Text="{Binding LayoutText}" Style="{StaticResource SecondaryText}"
                                                           Visibility="{Binding LayoutText, Converter={StaticResource NullToCollapsed}}" />
                                                <TextBlock Text="{Binding HintText}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                                           Visibility="{Binding HintText, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Border CornerRadius="11" Padding="10,3" HorizontalAlignment="Right"
                                                        Background="{Binding StatusKind, Converter={StaticResource StatusToBackground}}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding StatusKind, Converter={StaticResource StatusToBrush}}" />
                                                </Border>
                                                <ui:Button Content="ดูข้อมูลข้างใน" Appearance="Transparent" FontSize="12" Padding="6,2" Margin="0,4,0,0"
                                                           HorizontalAlignment="Right" Icon="{ui:SymbolIcon SearchInfo24}"
                                                           Command="{Binding DataContext.InspectDiskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                           CommandParameter="{Binding}"
                                                           Visibility="{Binding Info.MediaPresent, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>

                <!-- Step 3: options -->
                <ui:Card Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <Border Style="{StaticResource StepBadge}">
                                <TextBlock Text="3" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="ตัวเลือก" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>

                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ข้ามส่วนที่เหมือนเดิมบนการ์ด" FontSize="14" />
                                <TextBlock Style="{StaticResource SecondaryText}"
                                           Text="อ่านการ์ดก่อน ถ้าข้อมูลตรงกับไฟล์อยู่แล้วจะไม่เขียนซ้ำ — เร็วขึ้นหลายเท่าเมื่อเขียนทับการ์ดที่เคยลงไว้ และแทบไม่เสียเวลาเพิ่มกับการ์ดใหม่" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding SkipIdentical}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Separator Margin="0,6" />
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ตรวจสอบข้อมูลหลังเขียน" FontSize="14" />
                                <TextBlock Style="{StaticResource SecondaryText}"
                                           Text="อ่านกลับมาเทียบทีละไบต์ ใช้เวลาเพิ่มขึ้น แต่รู้ทันทีถ้าการ์ดเสียหรือเป็นการ์ดปลอม" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding Verify}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Separator Margin="0,6" />
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="เขียนอัตโนมัติเมื่อเสียบการ์ดใหม่" FontSize="14" />
                                <TextBlock Style="{StaticResource SecondaryText}"
                                           Text="สำหรับทำหลายใบติดกัน: เสียบการ์ด → เขียนทันที → มีเสียงเมื่อเสร็จ → ถอด → เสียบใบต่อไป" />
                            </StackPanel>
                            <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoMode}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>
        </DockPanel>

        <!-- ================= RIGHT: jobs ================= -->
        <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <ui:Button DockPanel.Dock="Right" Content="ล้างงานที่เสร็จ" Appearance="Transparent" Icon="{ui:SymbolIcon Dismiss24}"
                               Command="{Binding ClearFinishedCommand}" Visibility="{Binding HasJobs, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="สถานะการเขียน" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                </DockPanel>

                <Border DockPanel.Dock="Bottom" CornerRadius="6" Padding="10,8" Margin="0,10,0,0"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                    <DockPanel>
                        <ui:SymbolIcon Symbol="Info24" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Top"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                   Text="ถ้า Windows ขึ้นหน้าต่างให้ Format การ์ด ให้กด ยกเลิก (Cancel) เสมอ — การ์ดเครื่องชั่งใช้ระบบไฟล์ Linux ที่ Windows อ่านไม่ได้ ซึ่งเป็นเรื่องปกติ" />
                    </DockPanel>
                </Border>

                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"
                                Visibility="{Binding HasJobs, Converter={StaticResource InverseBoolToVisibility}}">
                        <ui:SymbolIcon Symbol="Storage24" FontSize="48" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="ยังไม่มีงานเขียน" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock Text="เลือกไฟล์และการ์ด แล้วกด เริ่มเขียน" Style="{StaticResource SecondaryText}" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Jobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:JobCard />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </ui:Card>
    </Grid>
</UserControl>
