<UserControl x:Class="ScaleFlash.App.Views.JobCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:ScaleFlash.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:JobViewModel}">
    <Border CornerRadius="8" Padding="14,12" Margin="0,0,0,10" BorderThickness="1"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- state icon -->
            <Border Grid.RowSpan="2" Width="38" Height="38" CornerRadius="19" Margin="0,0,12,0" VerticalAlignment="Top"
                    Background="{Binding Status, Converter={StaticResource StatusToBackground}}">
                <Grid>
                    <ui:ProgressRing Width="26" Height="26" IsIndeterminate="True"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <ui:SymbolIcon FontSize="22" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                   Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                        <Setter Property="Symbol" Value="ErrorCircle24" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="Warning">
                                        <Setter Property="Symbol" Value="Warning24" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Grid.Row="0">
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </StackPanel>

            <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
                <ui:SymbolIcon Symbol="Timer24" FontSize="14" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,8,0,4" FontSize="14" FontWeight="SemiBold"
                       Text="{Binding PhaseText}" Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />

            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Margin="0,4,0,0">
                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding StatsText}" FontSize="13" FontFamily="{StaticResource AppFont}"
                           Visibility="{Binding StatsText, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding NoteText}" Style="{StaticResource SecondaryText}"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}"
                           Visibility="{Binding NoteText, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding ResultText}" FontSize="13" TextWrapping="Wrap"
                           Visibility="{Binding ResultText, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Margin="0,2,0,0" Text="{Binding ErrorText}" FontSize="13" TextWrapping="Wrap"
                           Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"
                           Visibility="{Binding ErrorText, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>

            <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <ui:Button Content="ยกเลิก" Icon="{ui:SymbolIcon Stop24}" Command="{Binding CancelCommand}"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Content="ซ่อน" Icon="{ui:SymbolIcon Dismiss24}" Command="{Binding RemoveCommand}" Appearance="Transparent"
                           Visibility="{Binding IsRunning, Converter={StaticResource InverseBoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
